{
  "info": {
    "name": "CoffeeNChill - Part 1",
    "description": "Tests every HTTP endpoint from Part 1 of the CoffeeNChill PoE: Menu Items (Azure Table Storage) and Staff Documents (Azure Blob Storage), running behind Azurite.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "sample.pdf",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Menu Items",
      "item": [
        {
          "name": "Create Menu Item (Espresso)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"PartitionKey\": \"Hot Drinks\",\n    \"RowKey\": \"COF-001\",\n    \"Name\": \"Espresso\",\n    \"Description\": \"Rich and bold single shot of espresso.\",\n    \"Price\": 25.0,\n    \"IsAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response has the item name\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.Name).to.eql(\"Espresso\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Menu Item (Croissant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"PartitionKey\": \"Pastries\",\n    \"RowKey\": \"PAS-104\",\n    \"Name\": \"Ham & Cheese Croissant\",\n    \"Description\": \"Buttery croissant filled with ham and cheddar.\",\n    \"Price\": 42.5,\n    \"IsAvailable\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Menu Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Menu Items By Category (Hot Drinks)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/category/Hot%20Drinks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "category",
                "Hot%20Drinks"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Every item belongs to Hot Drinks\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    jsonData.forEach(function (item) {",
                  "        pm.expect(item.PartitionKey).to.eql(\"Hot Drinks\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Menu Item (Espresso price change)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/menu/Hot%20Drinks/COF-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "Hot%20Drinks",
                "COF-001"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"Price\": 28.0,\n    \"IsAvailable\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Menu Item (Espresso)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/menu/Hot%20Drinks/COF-001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "menu",
                "Hot%20Drinks",
                "COF-001"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204 No Content\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
